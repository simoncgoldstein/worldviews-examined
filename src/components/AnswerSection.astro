---
// One semantic section of an answer body. Injected around each "## Heading" by
// src/lib/remark-answer-sections.mjs. The "Deep dive" section (reading level 4, "Study") is a
// collapsible <details>; the analytical sections are grouped by AnswerLevel; every other section
// is always visible once its answer is open. Section marks (§, ◇) come from CSS keyed on
// `data-section`.
interface Props {
  ns: string;
  slug: string;
  title: string;
}

const { ns, slug, title } = Astro.props;
const id = `${ns}-${slug}`;
---

{
  slug === 'deep-dive' ? (
    <details class="level level--study deep-dive" data-level="study" data-section={slug}>
      <summary class="level__summary" id={id}>
        <span class="level__kicker">Study</span>
        <span class="level__title">{title}</span>
      </summary>
      <div class="level__body deep-dive__body prose">
        <slot />
      </div>
    </details>
  ) : (
    <section class="answer__section" data-section={slug} aria-labelledby={id}>
      <h3 class="answer__label" id={id}>{title}</h3>
      <slot />
    </section>
  )
}
