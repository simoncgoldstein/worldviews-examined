---
// Inline citation marker used inside answer MDX: <Cite source="…" locator="…" />.
// `ns`, `n` and `occurrence` are injected at build time by src/lib/remark-citations.mjs. `n` is
// the answer-local number; the displayed number adds the answer's page-level offset so citations
// run 1…N across the whole question page. Anchor ids stay answer-local, so they never collide.
import { answerByNamespace, getContent, lookup } from '../lib/content';
import { shortSource } from '../lib/citations';

interface Props {
  source: string;
  locator: string;
  ns: string;
  n: string;
  occurrence: string;
}

const { source, locator, ns, n, occurrence } = Astro.props;
const content = await getContent();
const registered = lookup(content.sourceById, source, 'source');
const number = answerByNamespace(content, ns).offset + Number(n);
const label = `Source ${number}: ${shortSource(registered)}, ${locator}`;
---

<sup class="cite"><a
    id={`${ns}-cite-${n}-${occurrence}`}
    href={`#${ns}-src-${n}`}
    aria-label={label}>{number}</a></sup>
