---
// One worldview's full answer to one question, in the question page's reading region.
// Metadata comes from frontmatter; all prose, and every section heading, comes from the MDX body
// (see src/lib/answer-sections.ts). The reviewed `lede` opens the answer as its one-sentence thesis.
//
// Progressive disclosure (Explore mode):
//   level 2, Understand  the view and what it explains well; visible as soon as the answer is open
//   level 3, Examine     the analytical sections, grouped by AnswerLevel into a native <details>
//   level 4, Study       the Deep dive <details>, then the Further study footer: key thinkers, links
//                        to the answer's references and the Source Library, and quieter navigation
// Without JavaScript every answer is open and the two inner levels are native disclosures.
// With JavaScript (src/scripts/answer-panels.ts) the heading becomes a disclosure button and
// answers start closed; the overview cards and fragment links open them.
// Citations are listed once for the whole question page (see SourceList and the question route).
import AnswerLevel from './AnswerLevel.astro';
import AnswerSection from './AnswerSection.astro';
import Cite from './Cite.astro';
import QuestionLink from './QuestionLink.astro';
import ThinkerLinks from './ThinkerLinks.astro';
import { getContent, lookup, worldviewUrl, type AnswerEntry } from '../lib/content';
import { symbols } from '../lib/labels';
import { url } from '../lib/paths';

interface Props {
  answer: AnswerEntry;
}

const { answer } = Astro.props;
const { data, Content, ns, citations } = answer;
const { worldviewById } = await getContent();
const worldview = lookup(worldviewById, data.worldviewId, 'worldview');
const headingId = `${ns}-heading`;
const panelId = `${ns}-panel`;
const { thinkers } = data;
---

<article class="answer" id={worldview.id} data-answer data-worldview={worldview.id} data-ns={ns} aria-labelledby={headingId}>
  <h2 class="answer__heading" id={headingId}>
    <span class="answer__name" data-answer-name>{worldview.name}</span>
  </h2>

  <div class="answer__panel" id={panelId} data-answer-panel>
    <div class="answer__inner">
      {data.lede && <p class="answer__thesis">{data.lede}</p>}

      <div class="answer__tools" data-answer-tools hidden>
        <button type="button" class="control" data-expand-sections aria-label={`Expand all sections of the ${worldview.name} answer`}>
          Expand all sections
        </button>
        <button type="button" class="control" data-collapse-sections aria-label={`Collapse all sections of the ${worldview.name} answer`}>
          Collapse all sections
        </button>
      </div>

      <div class="answer__body">
        <Content components={{ AnswerLevel, AnswerSection, Cite, QuestionLink }} />
      </div>

      <footer class="answer__footer further" aria-labelledby={`${ns}-further`}>
        <h3 class="further__title" id={`${ns}-further`}>Further study</h3>
        <div class="further__groups">
          {thinkers.length > 0 && (
            <section class="further__group" aria-labelledby={`${ns}-thinkers`}>
              <h4 class="further__label" id={`${ns}-thinkers`}>Key thinkers</h4>
              <ThinkerLinks ids={data.thinkers} />
            </section>
          )}
          {citations.length > 0 && (
            <section class="further__group" aria-labelledby={`${ns}-references`}>
              <h4 class="further__label" id={`${ns}-references`}>Sources</h4>
              <ul class="further__links">
                <li><a href={`#${ns}-sources`}>This answer’s references</a></li>
                <li><a href={url('sources/')}>Source Library</a></li>
              </ul>
            </section>
          )}
        </div>
        <ul class="answer__links further__nav">
          <li><a href={worldviewUrl(worldview)}>About {worldview.name}<span aria-hidden="true">&nbsp;{symbols.forward}</span></a></li>
          <li><a href="#overview">Back to all six answers</a></li>
        </ul>
      </footer>
    </div>
  </div>
</article>
