---
import { siteTitle } from '../data/site';
import { url } from '../lib/paths';
---

<footer class="site-footer">
  <div class="container">
    <p>
      <strong>{siteTitle}</strong> is written from a confessional Reformed Christian
      standpoint and does not claim neutrality. Competing worldviews are presented
      in forms their adherents could recognize.
    </p>
    <p>
      <a href={url('method/')}>Read the method</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-surface-alt);
    padding-block: var(--space-8);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .site-footer p {
    max-width: var(--measure);
    margin-bottom: var(--space-2);
  }
</style>
