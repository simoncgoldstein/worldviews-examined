---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteTitle, siteTagline } from '../data/site';
import { url } from '../lib/paths';
import '../styles/global.css';
// The two Latin faces used above the fold; other subsets load on demand through unicode-range.
import serifLatin from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';
import sansLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = siteTagline } = Astro.props;
const fullTitle = title ? `${title} · ${siteTitle}` : siteTitle;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#faf8f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14171a" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Theme: applies a saved Light/Dark choice from the header switch (ThemeSwitch.astro) before
      // first paint. With no valid saved choice, or no storage, the page follows the device. Kept
      // apart from the reading-mode script below; it reads one storage key and does nothing else.
      (function () {
        var root = document.documentElement;
        if (!window.CSS || !CSS.supports || !CSS.supports('color', 'light-dark(#000, #fff)')) return;
        var KEY = 'worldviews-theme';
        var COLORS = { light: '#faf8f3', dark: '#14171a' };
        var media = window.matchMedia('(prefers-color-scheme: dark)');
        // 'light', 'dark', null (no valid choice saved) or undefined (storage unavailable).
        function saved() {
          try {
            var value = localStorage.getItem(KEY);
            return value === 'light' || value === 'dark' ? value : null;
          } catch (e) {
            return undefined;
          }
        }
        // Pins the page to `theme`, or with null returns it to following the device.
        function apply(theme) {
          if (theme === undefined) return;
          if (theme) root.setAttribute('data-theme', theme);
          else root.removeAttribute('data-theme');
          var scheme = document.querySelector('meta[name="color-scheme"]');
          if (scheme) scheme.setAttribute('content', theme || 'light dark');
          var metas = document.querySelectorAll('meta[name="theme-color"]');
          for (var i = 0; i < metas.length; i++) {
            var own = /dark/.test(metas[i].getAttribute('media') || '') ? 'dark' : 'light';
            metas[i].setAttribute('content', COLORS[theme || own]);
          }
        }
        window.worldviewsTheme = {
          media: media,
          saved: saved,
          apply: apply,
          current: function () {
            return root.getAttribute('data-theme') || (media.matches ? 'dark' : 'light');
          },
          choose: function (theme) {
            apply(theme);
            try {
              localStorage.setItem(KEY, theme);
            } catch (e) {
              // Without storage the choice lasts for this page only.
            }
          },
        };
        apply(saved());
        root.classList.add('theme-switchable');
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href={url('sitemap.xml')} />
    <!-- Link previews: text only (the site has no preview image). -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={title ?? siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="preload" href={serifLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansLatin} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Lets CSS keep question-page answers collapsed until src/scripts/answer-panels.ts takes over.
      // Module scripts run after parsing and before DOMContentLoaded, so a page not marked ready by then
      // had its script blocked or failed. A script request that hangs also holds DOMContentLoaded back,
      // so give up 4 seconds after parsing ends (never earlier: a slow connection must not show the
      // text and then collapse it). If the script arrives later it leaves the answers open.
      var root = document.documentElement;
      root.classList.add('js');
      // A Compare or Christian Case URL: keep the Explore regions out of sight until modes.ts arranges the page.
      if (/[?&]mode=(?:compare|case)(?:&|$)/i.test(location.search)) root.classList.add('mode-pending');
      function readable() {
        if (!root.classList.contains('js-ready')) root.classList.remove('js');
      }
      document.addEventListener('DOMContentLoaded', readable);
      document.addEventListener('readystatechange', function () {
        if (document.readyState === 'interactive') setTimeout(readable, 4000);
      });
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/reveal-hash';
      import '../scripts/cite-preview';
    </script>
  </body>
</html>
