---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getContent, questionUrl } from '../../lib/content';

const content = await getContent();
const groups = content.categories.map((category) => ({
  category,
  questions: content.questions.filter((q) => q.category === category.id),
}));
---

<BaseLayout
  title="Questions"
  description="The foundational questions each worldview must answer, grouped into six domains."
>
  <div class="container page">
    <header class="page-head catalog-head">
      <h1>Questions</h1>
      <nav class="domain-nav" aria-label="Domains">
        <ol>
          {
            groups.map(({ category }) => (
              <li>
                <a href={`#${category.slug}`}>{category.title}</a>
              </li>
            ))
          }
        </ol>
      </nav>
    </header>

    <div class="catalog">
      {
        groups.map(({ category, questions }) => (
          <section class="catalog__domain" id={category.slug} aria-labelledby={`${category.slug}-heading`}>
            <h2 class="catalog__title" id={`${category.slug}-heading`}>{category.title}</h2>
            <ol class="catalog__questions">
              {questions.map((question) => (
                <li>
                  <a class="catalog__question" href={questionUrl(question)}>{question.title}</a>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>
