---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AnswerPanel from '../../components/AnswerPanel.astro';
import ChristianCaseView from '../../components/ChristianCaseView.astro';
import CompareView from '../../components/CompareView.astro';
import ModeSwitch from '../../components/ModeSwitch.astro';
import SourceList from '../../components/SourceList.astro';
import ThesisOverview from '../../components/ThesisOverview.astro';
import { answersForQuestion, getContent, lookup, questionUrl, worldviewUrl } from '../../lib/content';
import { symbols } from '../../lib/labels';
import { url } from '../../lib/paths';

export const getStaticPaths = (async () => {
  const { questions } = await getContent();
  return questions.map((question) => ({ params: { slug: question.slug }, props: { id: question.id } }));
}) satisfies GetStaticPaths;

const { id } = Astro.props;
const content = await getContent();
const question = lookup(content.questionById, id, 'question');
const category = lookup(content.categoryById, question.category, 'category');
const answers = answersForQuestion(content, question.id);
const answerByWorldview = new Map(answers.map((a) => [a.data.worldviewId, a]));
const related = question.relatedQuestions.map((rid) => lookup(content.questionById, rid, 'question'));
const hasSources = answers.some((a) => a.citations.length > 0);
// The Sources filter offers one option per answer that has a group of sources (SourceList.astro),
// in the same order; source-filter.ts reveals it once it can show and hide the groups.
const sourceGroups = answers
  .filter((a) => a.citations.length > 0)
  .map((a) => lookup(content.worldviewById, a.data.worldviewId, 'worldview'));
// Compare offers the worldviews that answer this question; it opens on the first two. Christian Case
// examines one of the alternatives from the Christian answer; it opens on the first alternative.
const answered = content.worldviews.filter((w) => answerByWorldview.has(w.id));
const firstPair: [string, string] = [answered[0]?.id ?? '', answered[1]?.id ?? ''];
const christian = answered.find((w) => w.analysisKind === 'christian');
const alternatives = christian ? answered.filter((w) => w.id !== christian.id) : [];
---

<BaseLayout title={question.title} description={question.summary}>
  <div class="container page question-page" data-mode="explore">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href={url('questions/')}>Questions</a></li>
        <li><a href={url(`questions/#${category.slug}`)}>{category.title}</a></li>
      </ol>
    </nav>

    <header class="question-head">
      <h1>{question.title}</h1>
    </header>

    {answered.length >= 2 && <ModeSwitch path={questionUrl(question)} pair={firstPair} opponent={alternatives[0]?.id} />}

    <section class="overview" id="overview" aria-labelledby="overview-heading">
      <div class="overview__head">
        <h2 class="kicker" id="overview-heading">Six answers at a glance</h2>
      </div>
      <ThesisOverview worldviews={content.worldviews} answers={answerByWorldview} />
    </section>

    {answered.length >= 2 && <CompareView worldviews={answered} />}
    {christian && alternatives.length > 0 && <ChristianCaseView path={questionUrl(question)} christian={christian} alternatives={alternatives} />}

    <section class="reading" aria-labelledby="reading-heading">
      <div class="reading__head">
        <h2 class="kicker" id="reading-heading">Full answers</h2>
        <div class="reading__tools" data-reading-tools hidden>
          <button type="button" class="control" data-open-answers>Open all six answers</button>
          <button type="button" class="control" data-close-answers>Close all answers</button>
        </div>
      </div>
      {
        content.worldviews.map((worldview) => {
          const answer = answerByWorldview.get(worldview.id);
          return answer ? (
            <AnswerPanel answer={answer} />
          ) : (
            <article class="answer answer--empty" id={worldview.id} data-worldview={worldview.id}>
              <h2 class="answer__heading"><a href={worldviewUrl(worldview)}>{worldview.name}</a></h2>
              <p class="status-note">No answer has been written for this question yet.</p>
            </article>
          );
        })
      }
    </section>

    {
      hasSources && (
        <section class="sources page-sources" id="sources" aria-labelledby="sources-heading">
          <h2 class="section-title" id="sources-heading">Sources</h2>
          {sourceGroups.length >= 2 && (
            <div class="source-filter" role="group" aria-label="Show sources for" data-source-filter hidden>
              <button type="button" class="source-filter__option" data-filter="all" aria-pressed="true">All</button>
              {sourceGroups.map((worldview) => (
                <button type="button" class="source-filter__option" data-filter={worldview.id} data-worldview={worldview.id} aria-pressed="false">
                  {worldview.name}
                </button>
              ))}
            </div>
          )}
          {answers.map((answer) => (
            <SourceList
              ns={answer.ns}
              citations={answer.citations}
              offset={answer.offset}
              heading={lookup(content.worldviewById, answer.data.worldviewId, 'worldview').name}
              worldview={answer.data.worldviewId}
            />
          ))}
        </section>
      )
    }

    {
      related.length > 0 && (
        <section class="related" aria-labelledby="related-heading">
          <h2 class="section-title" id="related-heading">Related questions</h2>
          <ul class="related__list">
            {related.map((r) => (
              <li>
                <a href={questionUrl(r)} data-related-link>{r.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <p class="question-page__back">
      <a href={url('questions/')}><span aria-hidden="true">{symbols.back}&nbsp;</span>All questions</a>
    </p>
  </div>
</BaseLayout>
