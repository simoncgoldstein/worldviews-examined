---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getContent, worldviewUrl } from '../../lib/content';

const content = await getContent();
---

<BaseLayout
  title="Worldviews"
  description="The six worldview families compared on this site, with the scope each one claims and does not claim."
>
  <div class="container page">
    <header class="page-head">
      <h1>Worldviews</h1>
      <p class="lede">Comparison families, not claims of total internal uniformity.</p>
    </header>

    <ul class="card-grid">
      {
        content.worldviews.map((worldview) => (
          <li data-worldview={worldview.id}>
            <h2 class="worldview-name"><a href={worldviewUrl(worldview)}>{worldview.name}</a></h2>
            <p>{worldview.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
