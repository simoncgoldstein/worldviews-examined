---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { answersForThinker, getContent, lookup, questionUrl, sourceUrl, worldviewUrl } from '../../lib/content';
import { lifespan } from '../../lib/format';
import { roleDescriptions, roleLabel, symbols } from '../../lib/labels';
import { url } from '../../lib/paths';

export const getStaticPaths = (async () => {
  const { thinkers } = await getContent();
  return thinkers.map((thinker) => ({ params: { slug: thinker.slug }, props: { id: thinker.id } }));
}) satisfies GetStaticPaths;

const { id } = Astro.props;
const content = await getContent();
const thinker = lookup(content.thinkerById, id, 'thinker');
const worldview = lookup(content.worldviewById, thinker.worldview, 'worldview');
const cited = answersForThinker(content, thinker);
const dates = lifespan(thinker);
---

<BaseLayout title={thinker.name} description={thinker.description}>
  <div class="container page">
    <a class="back-link" href={url('thinkers/')}><span aria-hidden="true">{symbols.back}&nbsp;</span>All thinkers</a>

    <header class="page-head">
      <h1>{thinker.name}</h1>
      <p class="meta thinker-meta">
        {dates && <><span>{dates}</span><span aria-hidden="true"> {symbols.separator} </span></>}
        <a href={worldviewUrl(worldview)}>{worldview.name}</a>
        <span aria-hidden="true"> {symbols.separator} </span>
        <span>{thinker.schools.join(', ')}</span>
        <span aria-hidden="true"> {symbols.separator} </span>
        <span class="role" data-role={thinker.role} title={roleDescriptions[thinker.role]}>{roleLabel(thinker)}</span>
      </p>
      <p class="lede">{thinker.description}</p>
      {thinker.usedFor.length > 0 && <p class="meta">Used for: {thinker.usedFor.join(', ')}</p>}
    </header>

    <div class="prose thinker-body">
      {
        thinker.bio && (
          <>
            <h2 class="section-title" style="margin-top:0">Biography</h2>
            <p>{thinker.bio}</p>
          </>
        )
      }

      {
        thinker.significance && (
          <>
            <h2 class="section-title">Why this thinker matters</h2>
            <p>{thinker.significance}</p>
          </>
        )
      }

      {
        thinker.keyIdeas.length > 0 && (
          <>
            <h2 class="section-title">Key ideas</h2>
            <ul class="inline-list key-ideas">
              {thinker.keyIdeas.map((idea) => <li>{idea}</li>)}
            </ul>
          </>
        )
      }

      {
        thinker.representativeWorks.length > 0 && (
          <>
            <h2 class="section-title">Representative works</h2>
            <ul>
              {thinker.representativeWorks.map((work) => {
                const registered = work.sourceId ? content.sourceById.get(work.sourceId) : undefined;
                const source = registered?.verificationStatus === 'checked' ? registered : undefined;
                return (
                  <li>
                    <cite class="is-work">{work.title}</cite>
                    {work.year && <span class="muted"> ({work.year})</span>}
                    {source && (
                      <span class="muted">
                        {' '}{symbols.separator} <a href={sourceUrl(source)}>in source registry</a>
                      </span>
                    )}
                  </li>
                );
              })}
            </ul>
          </>
        )
      }

      {
        thinker.notes && (
          <>
            <h2 class="section-title">Notes</h2>
            <p>{thinker.notes}</p>
          </>
        )
      }

      {
        cited.length > 0 && (
          <>
            <h2 class="section-title">Appears in these questions</h2>
            <ul>
              {cited.map((answer) => {
                const question = lookup(content.questionById, answer.data.questionId, 'question');
                const wv = lookup(content.worldviewById, answer.data.worldviewId, 'worldview');
                return (
                  <li>
                    <a href={`${questionUrl(question)}#${wv.id}`}>{question.title}</a>
                    <span class="muted"> {symbols.separator} {wv.shortName}</span>
                  </li>
                );
              })}
            </ul>
          </>
        )
      }

      <p class="meta">
        Grouping a thinker under a worldview is a reading aid, not a claim that this thinker speaks
        for every adherent.
      </p>
    </div>
  </div>
</BaseLayout>
