---
import BaseLayout from '../layouts/BaseLayout.astro';
import { homeQuestionIds, siteTitle } from '../data/site';
import { getContent, lookup, questionUrl, worldviewUrl } from '../lib/content';
import { symbols } from '../lib/labels';
import { url } from '../lib/paths';

const content = await getContent();
const starters = homeQuestionIds.map((id) => lookup(content.questionById, id, 'question'));
const questionCount = content.questions.length;
const worldviewCount = content.worldviews.length;
const numberWords = ['Zero', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten'];
const worldviewWord = numberWords[worldviewCount] ?? String(worldviewCount);
---

<BaseLayout>
  <div class="container page home">
    <header class="home-hero">
      <h1>{siteTitle}</h1>
      <p class="home-hero__claim">{`${questionCount} foundational questions. ${worldviewWord} worldviews.`}</p>
      <p class="home-hero__standpoint">A comparative examination from a Reformed Christian standpoint.</p>
      <p class="home-hero__actions">
        <a class="button-primary" href={url('questions/')}>Explore Questions<span aria-hidden="true">{symbols.forward}</span></a>
        <a class="text-link" href={url('method/')}>The Method</a>
      </p>
    </header>

    <section class="home-section" aria-labelledby="start-heading">
      <h2 class="home-section__title" id="start-heading">Begin with a question</h2>
      <ul class="home-questions">
        {
          starters.map((question) => (
            <li>
              <a href={questionUrl(question)}>
                <span>{question.title}</span>
                <span class="home-questions__arrow" aria-hidden="true">{symbols.forward}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="home-section__more">
        <a class="text-link" href={url('questions/')}>{`Browse all ${questionCount} questions`}<span aria-hidden="true">&nbsp;{symbols.forward}</span></a>
      </p>
    </section>

    <section class="home-section" aria-labelledby="worldviews-heading">
      <h2 class="home-section__title" id="worldviews-heading">{`${worldviewWord} worldviews`}</h2>
      <ul class="worldview-strip">
        {
          content.worldviews.map((worldview) => (
            <li data-worldview={worldview.id}>
              <a href={worldviewUrl(worldview)}><span class="wv-mark" aria-hidden="true" />{worldview.name}</a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>
